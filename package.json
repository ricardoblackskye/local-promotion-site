    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
