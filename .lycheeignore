# lychee checks the strings in vercel.json's Content-Security-Policy as if they were links.
# They are CSP source directives, not browsable pages - the domain roots legitimately 404.
https://fonts.googleapis.com
https://fonts.gstatic.com

# index.html links /favicon.svg - a WEB-root path. Vite serves public/ at the web root, so the
# file exists at runtime as public/favicon.svg. lychee resolves root-relative paths against the
# filesystem root (--root-dir .) and reports it missing. The file is real and is served: this is
# the checker's base path, not a broken link. Narrow pattern, so every other link is still checked.
^file://.*favicon\.svg$
